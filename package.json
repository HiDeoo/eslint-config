{
  "name": "@hideoo/eslint-config",
  "version": "5.1.0",
  "license": "MIT",
  "description": "HiDeoo's ESLint configuration",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "preview": "pnpm dlx eslint-flat-config-viewer",
    "lint": "prettier -c --cache . && eslint . --cache --max-warnings=0 && tsc --noEmit",
    "format": "prettier -w --cache .",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "astro-eslint-parser": "3.1.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "local-pkg": "1.2.1",
    "typescript-eslint": "8.70.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@hideoo/prettier-config": "2.0.1",
    "@hideoo/tsconfig": "2.0.3",
    "@types/eslint": "9.6.1",
    "@types/eslint-config-prettier": "6.11.3",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": ">=10.9.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "config",
    "eslint-config",
    "javascript",
    "typescript",
    "astro"
  ],
  "homepage": "https://github.com/HiDeoo/eslint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/eslint-config.git"
  },
  "bugs": "https://github.com/HiDeoo/eslint-config/issues",
  "prettier": "@hideoo/prettier-config"
}
